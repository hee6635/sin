<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ShiftCal" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.ShiftCal.Alarm" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    <style name="Theme.ShiftCal.WidgetPopup" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@style/SheetAnim</item>
    </style>
    <!-- v0.191 위젯 설정 화면: 실제 배경화면 위 -->
    <style name="Theme.ShiftCal.Wallpaper" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- v0.196 아래에서 올라오는 창 (앱 확인 창 · 위젯 날짜 창) -->
    <style name="SheetAnim">
        <item name="android:windowEnterAnimation">@anim/sheet_up</item>
        <item name="android:windowExitAnimation">@anim/sheet_down</item>
    </style>
</resources>
